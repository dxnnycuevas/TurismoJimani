@model AppDonnyCuevas20210074.Models.Cuenta.RegistroViewModel
@{
    Layout = "_LayoutSitio";
    ViewData["Title"] = "Crear cuenta";
    ViewData["Subtitulo"] = "Regístrate gratis en Turismo Jimaní.";
    ViewData["Descripcion"] = "Crea tu cuenta en Turismo Jimaní.";
}

<section class="jm-seccion pt-4">
    <div class="jm-manchas" aria-hidden="true">
        <span class="jm-mancha jm-mancha--naranja" style="width:420px;height:420px;top:0;left:-140px;opacity:.4"></span>
        <span class="jm-mancha jm-mancha--larimar" style="width:360px;height:360px;bottom:-80px;right:-80px;opacity:.35"></span>
    </div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6">
                <div class="jm-formulario jm-vidrio">
                    <div class="text-center mb-4">
                        <span class="jm-marca__icono mx-auto mb-3" style="width:64px;height:64px"><svg aria-hidden="true" style="width:44px;height:44px"><use href="#t-carita" /></svg></span>
                        <h2 class="jm-h2 h3 mb-1">Crea tu cuenta</h2>
                        <p class="text-body-secondary mb-0">Solo te toma un minuto.</p>
                    </div>

                    <form asp-controller="Cuenta" asp-action="Registro" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <select asp-for="TipoCuenta" id="tipo-cuenta" class="form-select">
                                        <option value="@DocumentoIdentidad.CuentaPersona">Persona</option>
                                        <option value="@DocumentoIdentidad.CuentaEmpresa">Empresa de viajes</option>
                                    </select>
                                    <label for="tipo-cuenta">Tipo de cuenta</label>
                                </div>
                                <span asp-validation-for="TipoCuenta" class="text-danger small"></span>
                            </div>
                            <div class="col-12" data-solo="@DocumentoIdentidad.CuentaEmpresa">
                                <div class="form-floating">
                                    <input asp-for="NombreEmpresa" class="form-control" placeholder="Nombre de la empresa" autocomplete="organization" />
                                    <label asp-for="NombreEmpresa"></label>
                                </div>
                                <span asp-validation-for="NombreEmpresa" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre completo" autocomplete="name" />
                                    <label id="etiqueta-nombre" asp-for="NombreCompleto"></label>
                                </div>
                                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <div class="form-floating">
                                    <select asp-for="TipoDocumento" id="tipo-documento" class="form-select">
                                        <option value="@DocumentoIdentidad.Cedula">Cédula</option>
                                        <option value="@DocumentoIdentidad.Pasaporte">Pasaporte</option>
                                        <option value="@DocumentoIdentidad.Rnc">RNC</option>
                                    </select>
                                    <label for="tipo-documento">Tipo de documento</label>
                                </div>
                                <span asp-validation-for="TipoDocumento" class="text-danger small"></span>
                            </div>
                            <div class="col-md-7">
                                <div class="form-floating">
                                    <input asp-for="NumeroDocumento" class="form-control" placeholder="Número de documento" autocomplete="off" />
                                    <label asp-for="NumeroDocumento"></label>
                                </div>
                                <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6" data-solo="@DocumentoIdentidad.CuentaPersona">
                                <div class="form-floating">
                                    <input asp-for="FechaNacimiento" class="form-control" placeholder="Fecha de nacimiento" autocomplete="bday" />
                                    <label asp-for="FechaNacimiento"></label>
                                </div>
                                <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6" data-solo="@DocumentoIdentidad.CuentaPersona">
                                <div class="form-floating">
                                    <input asp-for="Nacionalidad" class="form-control" placeholder="Nacionalidad" />
                                    <label asp-for="Nacionalidad"></label>
                                </div>
                                <span asp-validation-for="Nacionalidad" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Telefono" type="tel" class="form-control" placeholder="Teléfono" autocomplete="tel" />
                                    <label asp-for="Telefono"></label>
                                </div>
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Pais" class="form-control" placeholder="País" autocomplete="country-name" />
                                    <label asp-for="Pais"></label>
                                </div>
                                <span asp-validation-for="Pais" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Ciudad" class="form-control" placeholder="Ciudad" autocomplete="address-level2" />
                                    <label asp-for="Ciudad"></label>
                                </div>
                                <span asp-validation-for="Ciudad" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Direccion" class="form-control" placeholder="Dirección" autocomplete="street-address" />
                                    <label asp-for="Direccion"></label>
                                </div>
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Correo" type="email" class="form-control" placeholder="Correo electrónico" autocomplete="email" />
                                    <label asp-for="Correo"></label>
                                </div>
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Contrasena" class="form-control" placeholder="Contraseña" autocomplete="new-password" />
                                    <label asp-for="Contrasena"></label>
                                </div>
                                <span asp-validation-for="Contrasena" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ConfirmarContrasena" class="form-control" placeholder="Confirmar contraseña" autocomplete="new-password" />
                                    <label asp-for="ConfirmarContrasena"></label>
                                </div>
                                <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-text">
                                    @PoliticaContrasena.TextoAyuda
                                </div>
                            </div>
                            <div class="col-12">
                                <button class="jm-btn w-100" type="submit"><i class="fa fa-user-plus"></i>Crear cuenta</button>
                            </div>
                        </div>
                    </form>

                    <p class="text-center mt-4 mb-0">
                        ¿Ya tienes una cuenta?
                        <a asp-controller="Cuenta" asp-action="Ingresar" asp-route-returnUrl="@ViewBag.ReturnUrl" class="fw-semibold">Inicia sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Muestra los campos de persona o de empresa y los documentos que corresponden a cada una
        (() => {
            const cuenta = document.getElementById("tipo-cuenta");
            const documento = document.getElementById("tipo-documento");
            const etiquetaNombre = document.getElementById("etiqueta-nombre");
            const empresa = "@DocumentoIdentidad.CuentaEmpresa";
            const rnc = "@DocumentoIdentidad.Rnc";

            function actualizar() {
                const esEmpresa = cuenta.value === empresa;
                document.querySelectorAll("[data-solo]").forEach((c) => { c.hidden = c.dataset.solo !== cuenta.value; });
                [...documento.options].forEach((o) => {
                    const permitido = (o.value === rnc) === esEmpresa;
                    o.hidden = !permitido;
                    o.disabled = !permitido;
                });
                if (documento.selectedOptions[0]?.disabled) documento.value = esEmpresa ? rnc : "@DocumentoIdentidad.Cedula";
                etiquetaNombre.textContent = esEmpresa ? "Nombre del representante" : "Nombre completo";
            }

            cuenta.addEventListener("change", actualizar);
            actualizar();
        })();
    </script>
}
