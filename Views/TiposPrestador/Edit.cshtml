@model TipoPrestador
@{
    ViewData["Title"] = "Editar tipo de servicio";
}

<h2>Editar tipo de servicio</h2>
<hr />

<form asp-action="Edit" asp-route-id="@Model.IdTipoPrestador" method="post">
    <partial name="_Formulario" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
