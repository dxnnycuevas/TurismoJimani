@model Lugar
@{
    ViewData["Title"] = "Detalle de lugar";
}

<h2>Detalle de lugar</h2>
<hr />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre</dd>
        <dt class="col-sm-4">Municipio</dt>
        <dd class="col-sm-8">@Model.Municipio</dd>
        <dt class="col-sm-4">Provincia</dt>
        <dd class="col-sm-8">@Model.Provincia</dd>
        <dt class="col-sm-4">Descripción corta</dt>
        <dd class="col-sm-8"><span style="white-space:pre-line">@Model.DescripcionCorta</span></dd>
        <dt class="col-sm-4">Descripción</dt>
        <dd class="col-sm-8"><span style="white-space:pre-line">@Model.Descripcion</span></dd>
        <dt class="col-sm-4">Dirección</dt>
        <dd class="col-sm-8">@Model.Direccion</dd>
        <dt class="col-sm-4">Latitud</dt>
        <dd class="col-sm-8">@Formato.Numero(Model.Latitud)</dd>
        <dt class="col-sm-4">Longitud</dt>
        <dd class="col-sm-8">@Formato.Numero(Model.Longitud)</dd>
        <dt class="col-sm-4">Teléfono</dt>
        <dd class="col-sm-8">@Model.Telefono</dd>
        <dt class="col-sm-4">Correo</dt>
        <dd class="col-sm-8">@Model.Correo</dd>
        <dt class="col-sm-4">Sitio web</dt>
        <dd class="col-sm-8">@if (!string.IsNullOrEmpty(Model.SitioWeb)) { <a href="@Model.SitioWeb" target="_blank" rel="noopener">@Model.SitioWeb</a> }</dd>
        <dt class="col-sm-4">Activo</dt>
        <dd class="col-sm-8">@Formato.SiNo(Model.Activo)</dd>
        <dt class="col-sm-4">Fecha de creación</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaCreacion)</dd>
        <dt class="col-sm-4">Última actualización</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaActualizacion)</dd>
        <dt class="col-sm-4">Categorías</dt>
        <dd class="col-sm-8">@(Model.Categorias.Any() ? string.Join(", ", Model.Categorias.OrderBy(c => c.Nombre).Select(c => c.Nombre)) : "—")</dd>
        <dt class="col-sm-4">Comodidades</dt>
        <dd class="col-sm-8">@(Model.Servicios.Any() ? string.Join(", ", Model.Servicios.OrderBy(s => s.Nombre).Select(s => s.Nombre)) : "—")</dd>
        </dl>
    </div>
</div>

<partial name="_Album" model="(Model.Imagenes.AsEnumerable(), (int?)Model.IdLugar, (int?)null)" />

<a asp-action="Edit" asp-route-id="@Model.IdLugar" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
