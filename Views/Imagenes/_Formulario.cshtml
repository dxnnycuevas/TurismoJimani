@model Imagen

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-12">
        <label class="form-label d-block">¿A quién pertenece la foto?</label>
        <div class="btn-group" role="group" aria-label="Dueño de la foto">
            <input type="radio" class="btn-check" name="duenoFoto" id="dueno-lugar" value="lugar" autocomplete="off" checked="@(Model.IdPrestador == null)" />
            <label class="btn btn-outline-primary" for="dueno-lugar"><i class="fa fa-map-marker-alt me-1"></i>Lugar turístico</label>
            <input type="radio" class="btn-check" name="duenoFoto" id="dueno-prestador" value="prestador" autocomplete="off" checked="@(Model.IdPrestador != null)" />
            <label class="btn btn-outline-primary" for="dueno-prestador"><i class="fa fa-user-tie me-1"></i>Prestador de servicios</label>
        </div>
    </div>

    <div class="col-md-6" data-dueno="lugar">
        <label asp-for="IdLugar" class="form-label">Lugar</label>
        <select asp-for="IdLugar" class="form-select" asp-items="ViewBag.ListaIdLugar">
            <option value="">-- Seleccione --</option>
        </select>
        @if (ViewBag.ListaIdLugar is SelectList listaIdLugar && !listaIdLugar.Any())
        {
            <div class="form-text">No hay lugares disponibles. <a asp-controller="Lugares" asp-action="Create">Registrar un lugar</a></div>
        }
        <span asp-validation-for="IdLugar" class="text-danger small"></span>
    </div>

    <div class="col-md-6" data-dueno="prestador">
        <label asp-for="IdPrestador" class="form-label">Prestador de servicios</label>
        <select asp-for="IdPrestador" class="form-select" asp-items="ViewBag.ListaIdPrestador">
            <option value="">-- Seleccione --</option>
        </select>
        @if (ViewBag.ListaIdPrestador is SelectList listaIdPrestador && !listaIdPrestador.Any())
        {
            <div class="form-text">No hay prestadores registrados. <a asp-controller="Prestadores" asp-action="Create">Registrar un prestador</a></div>
        }
        <span asp-validation-for="IdPrestador" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label for="archivo" class="form-label">Subir foto desde la PC</label>
        <input type="file" id="archivo" name="archivo" class="form-control" accept="@AlmacenImagenes.ExtensionesAceptadas" />
        <div class="form-text">JPG, PNG, WEBP o GIF de hasta @(AlmacenImagenes.TamanoMaximoBytes / (1024 * 1024)) MB.@(string.IsNullOrEmpty(Model.UrlImagen) ? "" : " Si sube una nueva, reemplaza la actual.")</div>
        <span class="text-danger small">@Html.ValidationMessage("archivo")</span>
    </div>

    <div class="col-md-6">
        <label asp-for="UrlImagen" class="form-label">…o dirección web de la imagen</label>
        <input asp-for="UrlImagen" class="form-control" placeholder="https://" data-val="false" />
        <span asp-validation-for="UrlImagen" class="text-danger small"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.UrlImagen) && SitioPublico.UrlSegura(Model.UrlImagen) is string actual)
    {
        <div class="col-12">
            <img src="@actual" alt="Imagen actual" class="img-thumbnail" style="max-height:140px" />
        </div>
    }

    <div class="col-md-6">
        <label asp-for="TextoAlternativo" class="form-label">Texto alternativo</label>
        <input asp-for="TextoAlternativo" class="form-control" />
        <span asp-validation-for="TextoAlternativo" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="OrdenVisualizacion" class="form-label">Orden de visualización</label>
        <input asp-for="OrdenVisualizacion" class="form-control" type="number" min="0" />
        <span asp-validation-for="OrdenVisualizacion" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <h6 class="mt-2 mb-0">Crédito de la imagen</h6>
        <div class="form-text">Se muestra junto a la foto en el sitio público para reconocer a su dueño original.</div>
    </div>

    <div class="col-md-4">
        <label asp-for="Autor" class="form-label">Autor o dueño original</label>
        <input asp-for="Autor" class="form-control" placeholder="Ej.: Juan Pérez" />
        <span asp-validation-for="Autor" class="text-danger small"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="FuenteUrl" class="form-label">Enlace a la fuente original</label>
        <input asp-for="FuenteUrl" class="form-control" type="url" placeholder="https://" />
        <span asp-validation-for="FuenteUrl" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Licencia" class="form-label">Licencia o permiso</label>
        <input asp-for="Licencia" class="form-control" list="licencias-comunes" placeholder="Ej.: CC BY-SA 4.0" />
        <datalist id="licencias-comunes">
            <option value="Uso autorizado por el autor"></option>
            <option value="CC BY 4.0"></option>
            <option value="CC BY-SA 4.0"></option>
            <option value="Dominio público"></option>
        </datalist>
        <span asp-validation-for="Licencia" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="EsPrincipal" class="form-check-input" />
            <label asp-for="EsPrincipal" class="form-check-label">Es la imagen principal</label>
        </div>
    </div>
</div>

<script>
    // Muestra solo la lista del dueño elegido y vacía la otra para que se envíe una sola
    (function () {
        const bloques = document.querySelectorAll("[data-dueno]");
        function aplicar() {
            const elegido = document.querySelector("input[name=duenoFoto]:checked")?.value ?? "lugar";
            bloques.forEach(b => {
                const visible = b.dataset.dueno === elegido;
                b.hidden = !visible;
                const lista = b.querySelector("select");
                if (!visible && lista) lista.value = "";
            });
        }
        document.querySelectorAll("input[name=duenoFoto]").forEach(r => r.addEventListener("change", aplicar));
        aplicar();
    })();
</script>
