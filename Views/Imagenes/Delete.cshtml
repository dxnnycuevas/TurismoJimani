@model Imagen
@{
    ViewData["Title"] = "Eliminar imagen";
}

<h2>Eliminar imagen</h2>
<hr />

<div class="alert alert-danger">¿Está seguro de que desea eliminar este registro? Esta acción no se puede deshacer.</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">URL de la imagen</dt>
        <dd class="col-sm-8"><img src="@Model.UrlImagen" alt="@Model.TextoAlternativo" class="img-fluid rounded mb-2" style="max-height:240px" /><br /><a href="@Model.UrlImagen" target="_blank" rel="noopener" class="small">@Model.UrlImagen</a></dd>
        <dt class="col-sm-4">Pertenece a</dt>
        <dd class="col-sm-8">@(Model.Lugar?.Nombre ?? Model.Prestador?.Nombre)<span class="text-muted small ms-1">(@(Model.IdLugar != null ? "Lugar" : "Prestador de servicios"))</span></dd>
        <dt class="col-sm-4">Texto alternativo</dt>
        <dd class="col-sm-8">@Model.TextoAlternativo</dd>
        <dt class="col-sm-4">Orden de visualización</dt>
        <dd class="col-sm-8">@Model.OrdenVisualizacion</dd>
        <dt class="col-sm-4">Es la imagen principal</dt>
        <dd class="col-sm-8">@Formato.SiNo(Model.EsPrincipal)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdImagen" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
