@model IEnumerable<Imagen>
@{
    ViewData["Title"] = "Imágenes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">Imágenes</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva imagen</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por lugar o prestador" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay registros para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>URL de la imagen</th>
                    <th>Pertenece a</th>
                    <th>Texto alternativo</th>
                    <th>Crédito</th>
                    <th>Orden de visualización</th>
                    <th>Es la imagen principal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><img src="@item.UrlImagen" alt="@item.TextoAlternativo" class="img-thumbnail" style="max-height:60px" /></td>
                        <td>@(item.Lugar?.Nombre ?? item.Prestador?.Nombre)<div class="text-muted small">@(item.IdLugar != null ? "Lugar" : "Prestador de servicios")</div></td>
                        <td>@item.TextoAlternativo</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Autor) ? "—" : item.Autor)</td>
                        <td>@item.OrdenVisualizacion</td>
                        <td>@Formato.SiNo(item.EsPrincipal)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.IdImagen" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.IdImagen" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdImagen" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Total: @Model.Count() registro(s)</p>
}
