@model AppDonnyCuevas20210074.Models.Sitio.EstadisticasSitio
@{
    ViewData["Title"] = "Sobre Jimaní";
    ViewData["Subtitulo"] = "Frontera, lago y montaña: la historia y la cultura del municipio cabecera de Independencia.";
    ViewData["Descripcion"] = "Conoce Jimaní, municipio de la provincia Independencia entre el Lago Enriquillo y la Sierra de Bahoruco.";

    var cifras = new[]
    {
        (Model.Lugares, "Lugares", "fa-map-marker-alt"),
        (Model.Atractivos, "Atractivos", "fa-mountain"),
        (Model.Prestadores, "Prestadores de servicios", "fa-concierge-bell"),
        (Model.Alojamientos, "Alojamientos", "fa-hotel"),
        (Model.Rutas, "Rutas", "fa-route"),
        (Model.Eventos, "Eventos próximos", "fa-calendar-alt"),
    };

    var claves = new[]
    {
        ("t-lago", "Lago Enriquillo", "El lago más grande de las Antillas y el punto más bajo del Caribe, hogar de cocodrilos, iguanas y flamencos."),
        ("t-cactus", "Tierra árida", "Bosque seco, cactus y guayacanes: uno de los paisajes más secos y cálidos del país."),
        ("t-carita", "Memoria taína", "Las Caritas, petroglifos tallados frente al lago, y la historia del cacique Enriquillo en la Sierra de Bahoruco."),
        ("t-sol", "Vida de frontera", "Uno de los principales pasos hacia Haití y el Mercado Binacional, donde se encuentran dos culturas."),
    };
}

<section class="jm-seccion pt-4">
    <div class="jm-manchas" aria-hidden="true">
        <span class="jm-mancha jm-mancha--naranja" style="width:460px;height:460px;top:-120px;right:-160px;opacity:.4"></span>
    </div>
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 jm-revelar">
                <figure class="jm-poster jm-vidrio" style="transform:rotate(-2deg)">
                    <button type="button" class="jm-poster__boton" data-dato aria-label="Mostrar un dato curioso de Jimaní">
                        <img src="~/sitio/img/mapa-jimani-cartoart.webp" alt="Mapa de las calles de Jimaní" width="1333" height="2000" loading="lazy" />
                    </button>
                    <figcaption>
                        Mapa: <a href="https://www.cartoart.net" target="_blank" rel="noopener">CartoArt</a> · &copy; OpenStreetMap · &copy; OpenFreeMap
                    </figcaption>
                </figure>
            </div>
            <div class="col-lg-6 jm-revelar">
                <span class="jm-kicker"><svg aria-hidden="true"><use href="#t-carita" /></svg>Nuestra tierra</span>
                <h2 class="jm-h2">Bienvenido a <span style="color:var(--naranja-600)">Jimaní</span></h2>
                <p>
                    Jimaní es el municipio cabecera de la provincia Independencia, en el suroeste de la República Dominicana.
                    Está en el extremo occidental de la Hoya de Enriquillo, junto a la frontera con Haití, entre el
                    Lago Enriquillo y las montañas de la Sierra de Bahoruco.
                </p>
                <p>
                    Su paisaje árido, sus aguas saladas y su historia taína lo hacen un destino ideal para el turismo de
                    naturaleza, el senderismo y la observación de fauna. También es un lugar para conocer la vida y el
                    comercio de la frontera.
                </p>
                <p class="mb-4">
                    Turismo Jimaní reúne en un solo lugar lo que necesitas para tu visita: qué ver, dónde dormir y comer,
                    cómo moverte, la agenda de fiestas y un asistente virtual que responde tus dudas.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="jm-btn" asp-action="Lugares"><i class="fa fa-compass"></i>Explorar destinos</a>
                    <button type="button" class="jm-btn jm-btn--vidrio" data-dato>
                        <svg class="jm-simbolo-icono text-danger" aria-hidden="true"><use href="#t-carita" /></svg>Un dato al azar
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-4">
            @foreach (var (icono, titulo, texto) in claves)
            {
                <div class="col-sm-6 col-lg-3 jm-revelar">
                    <div class="jm-cultura jm-vidrio jm-liquido">
                        <span class="jm-cultura__icono" style="background:linear-gradient(145deg,var(--naranja-500),var(--naranja-600))" aria-hidden="true">
                            <svg><use href="#@icono" /></svg>
                        </span>
                        <h3>@titulo</h3>
                        <p>@texto</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Cifras -->
<section class="jm-seccion jm-seccion--azul">
    <div class="jm-patron jm-patron--claro" aria-hidden="true"></div>
    <div class="container">
        <div class="jm-titulo-seccion">
            <span class="jm-kicker"><i class="fa fa-chart-bar"></i>En cifras</span>
            <h2 class="jm-h2">Todo lo que encontrarás</h2>
        </div>
        <div class="row g-3">
            @foreach (var (total, nombre, icono) in cifras)
            {
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="jm-vidrio jm-vidrio--oscuro jm-liquido text-center p-4 h-100">
                        <i class="fa @icono fa-2x mb-3" style="color:var(--naranja-300)"></i>
                        <div class="display-6 fw-bold text-white" data-contar="@total">@total</div>
                        <div>@nombre</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<partial name="_SimbologiaTaina" />
<partial name="_CulturaDominicana" />
<partial name="_BannerAsistente" />
