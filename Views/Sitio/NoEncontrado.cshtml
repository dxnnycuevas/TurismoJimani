@{
    var codigo = (int?)ViewBag.Codigo ?? 404;
    var noEncontrado = codigo == 404;
    ViewData["Title"] = noEncontrado ? "Página no encontrada" : "No se pudo mostrar la página";
    ViewData["Subtitulo"] = noEncontrado
        ? "El lugar, servicio o página que buscas no existe o ya no está publicado."
        : "Ocurrió un problema al abrir esta página.";
    ViewData["Descripcion"] = ViewData["Title"];
}

<section class="jm-seccion pt-4">
    <div class="container">
        <div class="jm-panel jm-vidrio text-center mx-auto" style="max-width:640px">
            <button type="button" class="jm-carita-boton mx-auto" style="width:110px;height:110px" data-dato>
                <svg aria-hidden="true" style="width:70px;height:70px"><use href="#t-carita" /></svg>
                <span class="visually-hidden">Mostrar un dato curioso</span>
            </button>
            <p class="jm-kicker justify-content-center mt-3 mb-1">Error @codigo</p>
            <h2 class="h4 mb-3">@(noEncontrado ? "No encontramos lo que buscas" : "Algo salió mal")</h2>
            <p class="mb-4">
                @(noEncontrado
                    ? "Puede que el enlace esté incompleto o que el contenido se haya retirado. Desde aquí puedes seguir explorando Jimaní."
                    : "Intenta de nuevo en unos minutos o vuelve al inicio.")
            </p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a asp-controller="Sitio" asp-action="Index" class="jm-btn"><i class="fa fa-home"></i>Volver al inicio</a>
                <a asp-controller="Sitio" asp-action="Lugares" class="jm-btn jm-btn--azul"><i class="fa fa-map-marked-alt"></i>Ver destinos</a>
                <a asp-controller="Asistente" asp-action="Index" class="jm-btn jm-btn--contorno"><i class="fa fa-comments"></i>Preguntar al asistente</a>
            </div>
        </div>
    </div>
</section>
