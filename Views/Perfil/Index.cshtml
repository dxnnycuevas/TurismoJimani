@model AppDonnyCuevas20210074.Models.Sitio.PerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    ViewData["Subtitulo"] = $"Hola, {Model.Nombre}. Aquí están tus lugares favoritos, tus planes de viaje y tus conversaciones con el asistente.";
    ViewData["Descripcion"] = "Perfil del visitante de Turismo Jimaní.";

    var totalFavoritos = Model.LugaresFavoritos.Count + Model.PrestadoresFavoritos.Count;
    string Activa(string s) => Model.Seccion == s ? "active" : "";
    string Mostrar(string s) => Model.Seccion == s ? "show active" : "";
    string Dinero(decimal v) => "RD$ " + v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture);
}

<section class="jm-seccion pt-4">
    <div class="container">
        @if (TempData["Error"] is string error)
        {
            <div class="jm-alerta mb-4" role="alert"><i class="fa fa-exclamation-triangle text-danger me-2"></i>@error</div>
        }

        <div class="perfil-pestanas d-flex flex-wrap gap-2 mb-4" role="tablist">
            <button class="jm-chip @Activa("favoritos")" data-bs-toggle="pill" data-bs-target="#perfil-favoritos" type="button" role="tab">
                <i class="fa fa-heart"></i>Favoritos <span class="perfil-cuenta">@totalFavoritos</span>
            </button>
            <button class="jm-chip @Activa("planes")" data-bs-toggle="pill" data-bs-target="#perfil-planes" type="button" role="tab">
                <i class="fa fa-suitcase-rolling"></i>Planes de viaje <span class="perfil-cuenta">@Model.Planes.Count</span>
            </button>
            <button class="jm-chip @Activa("conversaciones")" data-bs-toggle="pill" data-bs-target="#perfil-conversaciones" type="button" role="tab">
                <i class="fa fa-comments"></i>Mis conversaciones <span class="perfil-cuenta">@Model.Conversaciones.Count</span>
            </button>
            <button class="jm-chip @Activa("cuenta")" data-bs-toggle="pill" data-bs-target="#perfil-cuenta" type="button" role="tab">
                <i class="fa fa-user-cog"></i>Mi cuenta
            </button>
        </div>

        <div class="tab-content">
            @* ---------------- Favoritos ---------------- *@
            <div class="tab-pane fade @Mostrar("favoritos")" id="perfil-favoritos" role="tabpanel">
                @if (totalFavoritos == 0)
                {
                    <div class="jm-panel jm-vidrio text-center">
                        <p class="mb-3">Todavía no guardas favoritos. Abre la ficha de un lugar o de un prestador y pulsa <strong>Guardar en favoritos</strong>.</p>
                        <a asp-controller="Sitio" asp-action="Lugares" class="jm-btn"><i class="fa fa-map-marked-alt"></i>Explorar destinos</a>
                    </div>
                }
                @if (Model.LugaresFavoritos.Count > 0)
                {
                    <h2 class="h5 mb-3">Lugares</h2>
                    <div class="row g-4 mb-4">
                        @for (var i = 0; i < Model.LugaresFavoritos.Count; i++)
                        {
                            var lugar = Model.LugaresFavoritos[i];
                            <div class="col-md-6 col-lg-4">
                                <partial name="~/Views/Sitio/_TarjetaLugar.cshtml" model="(lugar, i)" />
                                <form asp-action="Favorito" method="post" class="mt-2 text-center">
                                    <input type="hidden" name="tipo" value="lugar" />
                                    <input type="hidden" name="id" value="@lugar.IdLugar" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", new { seccion = "favoritos" })" />
                                    <button type="submit" class="btn btn-link btn-sm"><i class="fa fa-heart-broken me-1"></i>Quitar de favoritos</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                @if (Model.PrestadoresFavoritos.Count > 0)
                {
                    <h2 class="h5 mb-3">Dónde dormir, comer y quién te lleva</h2>
                    <div class="row g-4">
                        @for (var i = 0; i < Model.PrestadoresFavoritos.Count; i++)
                        {
                            var p = Model.PrestadoresFavoritos[i];
                            <div class="col-md-6 col-lg-4">
                                <partial name="~/Views/Sitio/_TarjetaPrestador.cshtml" model="(p, i)" />
                                <form asp-action="Favorito" method="post" class="mt-2 text-center">
                                    <input type="hidden" name="tipo" value="prestador" />
                                    <input type="hidden" name="id" value="@p.IdPrestador" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", new { seccion = "favoritos" })" />
                                    <button type="submit" class="btn btn-link btn-sm"><i class="fa fa-heart-broken me-1"></i>Quitar de favoritos</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ---------------- Planes de viaje ---------------- *@
            <div class="tab-pane fade @Mostrar("planes")" id="perfil-planes" role="tabpanel">
                @if (Model.Planes.Count == 0)
                {
                    <div class="jm-panel jm-vidrio text-center">
                        <p class="mb-3">Pídele al asistente un plan, por ejemplo «tengo 10,000 pesos para 3 días», y pulsa <strong>Guardar en mi perfil</strong> en la tarjeta del plan.</p>
                        <a asp-controller="Asistente" asp-action="Index" asp-route-pregunta="Tengo 10,000 pesos para 3 días" class="jm-btn"><i class="fa fa-robot"></i>Planificar con el asistente</a>
                    </div>
                }
                <div class="row g-4">
                    @foreach (var plan in Model.Planes)
                    {
                        <div class="col-lg-6">
                            <article class="jm-panel jm-vidrio h-100 perfil-plan">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h2 class="h5 mb-1">@(plan.Noches == 1 ? "1 noche" : $"{plan.Noches} noches")@(string.IsNullOrEmpty(plan.Origen) ? "" : $" desde {plan.Origen}")</h2>
                                        <span class="small text-muted">Guardado el @plan.Fecha.ToString("d 'de' MMMM 'de' yyyy, h:mm tt")</span>
                                    </div>
                                    <span class="jm-etiqueta @(plan.Cabe ? "" : "jm-etiqueta--solida")">@(plan.Cabe ? "Te alcanza" : "No alcanza")</span>
                                </div>
                                <ul class="list-unstyled mb-3">
                                    @foreach (var l in plan.Lineas)
                                    {
                                        <li class="perfil-plan__linea">
                                            <div>
                                                <span class="small text-muted d-block">@l.Concepto</span>
                                                @if (!string.IsNullOrEmpty(l.Url))
                                                {
                                                    <a href="@l.Url">@l.Opcion</a>
                                                }
                                                else
                                                {
                                                    <span>@l.Opcion</span>
                                                }
                                                <span class="small text-muted d-block">@l.Detalle</span>
                                            </div>
                                            <strong>@Dinero(l.Subtotal)</strong>
                                        </li>
                                    }
                                </ul>
                                <div class="perfil-plan__total"><span>Total</span><strong>@Dinero(plan.Total)</strong></div>
                                <p class="small mb-3">Presupuesto: @Dinero(plan.Monto). Los precios son los registrados el día que se guardó el plan.</p>
                                <form asp-action="EliminarPlan" asp-route-id="@plan.Id" method="post" data-confirmar="¿Eliminar este plan de viaje?">
                                    <button type="submit" class="btn btn-link btn-sm p-0"><i class="fa fa-trash-alt me-1"></i>Eliminar plan</button>
                                </form>
                            </article>
                        </div>
                    }
                </div>
            </div>

            @* ---------------- Conversaciones ---------------- *@
            <div class="tab-pane fade @Mostrar("conversaciones")" id="perfil-conversaciones" role="tabpanel">
                <div class="jm-panel jm-vidrio mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <p class="mb-0">
                        Mientras tienes la sesión iniciada, tus preguntas al asistente se guardan aquí.
                        Tienes <strong>@Model.Conversaciones.Count</strong> @(Model.Conversaciones.Count == 1 ? "conversación" : "conversaciones")
                        (@Model.TotalMensajes @(Model.TotalMensajes == 1 ? "mensaje" : "mensajes")).
                    </p>
                    @if (Model.TotalMensajes > 0)
                    {
                        <form asp-action="BorrarHistorial" method="post"
                              data-confirmar="Se borrarán todas tus conversaciones con el asistente. Esta acción no se puede deshacer. ¿Continuar?">
                            <button type="submit" class="jm-btn jm-btn--sm"><i class="fa fa-trash-alt"></i>Borrar todo mi historial</button>
                        </form>
                    }
                </div>

                @foreach (var c in Model.Conversaciones)
                {
                    <details class="jm-panel jm-vidrio mb-3 perfil-conversacion">
                        <summary>
                            <span class="fw-semibold">@c.Mensajes[0].MensajeUsuario</span>
                            <span class="small text-muted d-block">
                                @c.Inicio.ToString("d 'de' MMMM 'de' yyyy, h:mm tt") ·
                                @(c.Mensajes.Count == 1 ? "1 mensaje" : $"{c.Mensajes.Count} mensajes")
                            </span>
                        </summary>
                        <div class="mt-3">
                            @foreach (var m in c.Mensajes)
                            {
                                <div class="chat-mensaje chat-usuario"><div class="chat-autor">Tú:</div><div class="chat-texto">@m.MensajeUsuario</div></div>
                                <div class="chat-mensaje chat-asistente"><div class="chat-autor">Asistente:</div><div class="chat-texto">@m.RespuestaAsistente</div></div>
                            }
                            <form asp-action="BorrarConversacion" method="post" class="mt-2" data-confirmar="¿Borrar esta conversación?">
                                <input type="hidden" name="idSesion" value="@c.IdSesion" />
                                <button type="submit" class="btn btn-link btn-sm p-0"><i class="fa fa-trash-alt me-1"></i>Borrar esta conversación</button>
                            </form>
                        </div>
                    </details>
                }
            </div>

            @* ---------------- Cuenta ---------------- *@
            <div class="tab-pane fade @Mostrar("cuenta")" id="perfil-cuenta" role="tabpanel">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="jm-panel jm-vidrio h-100">
                            <h2 class="h5 mb-3">Tus datos</h2>
                            <div class="lugar-dato"><i class="fa fa-user"></i><div><span class="etiqueta">Nombre</span>@Model.Nombre</div></div>
                            <div class="lugar-dato"><i class="fa fa-envelope"></i><div><span class="etiqueta">Correo</span>@Model.Correo</div></div>
                            <div class="lugar-dato"><i class="fa fa-calendar-check"></i><div><span class="etiqueta">Cuenta creada</span>@Model.Registro.ToString("d 'de' MMMM 'de' yyyy")</div></div>
                            <a asp-controller="Cuenta" asp-action="CambiarContrasena" class="jm-btn jm-btn--contorno mt-3"><i class="fa fa-key"></i>Cambiar contraseña</a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="jm-panel jm-vidrio h-100">
                            <h2 class="h5 mb-2">Eliminar mi cuenta</h2>
                            <p>Se borran tu cuenta, tus favoritos, tus planes de viaje y todas tus conversaciones con el asistente. No se puede deshacer.</p>
                            <form asp-action="EliminarCuenta" method="post" data-confirmar="¿Eliminar tu cuenta y todos tus datos? Esta acción no se puede deshacer.">
                                <label for="contrasena-eliminar" class="form-label">Escribe tu contraseña para confirmar</label>
                                <input id="contrasena-eliminar" name="contrasena" type="password" class="form-control mb-3" autocomplete="current-password" required />
                                <button type="submit" class="jm-btn"><i class="fa fa-user-times"></i>Eliminar mi cuenta</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
