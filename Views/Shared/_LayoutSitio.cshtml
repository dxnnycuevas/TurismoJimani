@* Diseño del sitio público de Turismo Jimaní: paleta de tierra árida (naranjas), azules del lago
   y la bandera, rojo para los ítems, simbología taína y efectos de vidrio líquido (jimani.css). *@
@inject Microsoft.Extensions.Configuration.IConfiguration Configuracion
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(params string[] acciones) =>
        controlador == "Sitio" && acciones.Contains(accion) ? "active" : "";

    var direccion = Configuracion["SitioPublico:Direccion"];
    var telefono = Configuracion["SitioPublico:Telefono"];
    var correo = Configuracion["SitioPublico:Correo"];

    var estaConectado = User.Identity?.IsAuthenticated == true;
    var esPersonal = RolesSistema.EsPersonal(User);
    var urlMapa = Url.Content("~/sitio/img/mapa-jimani-cartoart.webp");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Turismo Jimaní</title>
    <meta name="description" content="@(ViewData["Descripcion"] ?? "Descubre Jimaní: Lago Enriquillo, Sierra de Bahoruco, caritas taínas, fiestas patronales, alojamientos, restaurantes, guías, servicios y rutas.")" />
    <meta name="theme-color" content="#c2561a" />
    <script>document.documentElement.classList.add("jm-js");</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/sitio/css/jimani.css" asp-append-version="true" />
</head>
<body class="jm" data-url-dato="@Url.Action("Dato", "Sitio")">
    <partial name="_SimbolosTainos" />

    <a href="#contenido" class="visually-hidden-focusable jm-btn position-absolute m-2" style="z-index:2000">Saltar al contenido</a>

    <!-- Barra superior -->
    <div class="jm-topbar d-none d-lg-block">
        <div class="container d-flex justify-content-between align-items-center py-2 gap-3">
            <div class="d-flex align-items-center gap-4">
                @if (!string.IsNullOrWhiteSpace(direccion))
                {
                    <span><i class="fa fa-map-marker-alt me-2"></i>@direccion</span>
                }
                @if (!string.IsNullOrWhiteSpace(telefono))
                {
                    <a href="tel:@telefono"><i class="fa fa-phone-alt me-2"></i>@telefono</a>
                }
                @if (!string.IsNullOrWhiteSpace(correo))
                {
                    <a href="mailto:@correo"><i class="fa fa-envelope me-2"></i>@correo</a>
                }
            </div>
            <div class="d-flex align-items-center gap-3">
                @* El acceso de administración no se enlaza aquí: se entra directamente por /admin *@
                @if (estaConectado)
                {
                    <span><i class="fa fa-user me-2"></i>Hola, @User.Identity!.Name</span>
                    @if (esPersonal)
                    {
                        <a asp-controller="Home" asp-action="Index"><i class="fa fa-cog me-2"></i>Panel</a>
                    }
                    <form asp-controller="Cuenta" asp-action="Salir" method="post" class="m-0">
                        <button type="submit" class="btn btn-link btn-sm p-0"><i class="fa fa-sign-out-alt me-2"></i>Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Cuenta" asp-action="Registro"><i class="fa fa-user-plus me-2"></i>Registrarse</a>
                    <a asp-controller="Cuenta" asp-action="Ingresar"><i class="fa fa-sign-in-alt me-2"></i>Iniciar sesión</a>
                }
            </div>
        </div>
    </div>

    <!-- Navegación -->
    <header class="jm-nav">
        <div class="container">
            <nav class="navbar navbar-expand-lg jm-vidrio" aria-label="Principal">
                <a asp-controller="Sitio" asp-action="Index" class="jm-marca me-lg-4">
                    <span class="jm-marca__icono"><svg aria-hidden="true"><use href="#t-carita" /></svg></span>
                    <span>Turismo Jimaní<small>Independencia · RD</small></span>
                </a>
                <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#menuSitio"
                        aria-controls="menuSitio" aria-expanded="false" aria-label="Mostrar menú">
                    <i class="fa fa-bars"></i>
                </button>
                <div class="collapse navbar-collapse" id="menuSitio">
                    <ul class="navbar-nav mx-auto gap-lg-1">
                        <li class="nav-item"><a asp-controller="Sitio" asp-action="Index" class="nav-link @Activo("Index")">Inicio</a></li>
                        <li class="nav-item"><a asp-controller="Sitio" asp-action="Nosotros" class="nav-link @Activo("Nosotros")">Sobre Jimaní</a></li>
                        <li class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle @Activo("Lugares", "Lugar")" data-bs-toggle="dropdown" aria-expanded="false">Destinos</a>
                            <ul class="dropdown-menu">
                                <li><a asp-controller="Sitio" asp-action="Lugares" class="dropdown-item">Todos los lugares</a></li>
                                <li><a asp-controller="Sitio" asp-action="Lugares" asp-route-tipo="atractivos" class="dropdown-item"><i class="fa fa-mountain fa-fw me-2 text-danger"></i>Atractivos</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a asp-controller="Sitio" asp-action="Sorpresa" class="dropdown-item"><i class="fa fa-dice fa-fw me-2 text-danger"></i>Sorpréndeme</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle @Activo("Servicios", "Prestador")" data-bs-toggle="dropdown" aria-expanded="false">Servicios</a>
                            <ul class="dropdown-menu">
                                <li><a asp-controller="Sitio" asp-action="Servicios" class="dropdown-item">Todos los servicios</a></li>
                                @foreach (var grupo in SitioPublico.GruposServicio)
                                {
                                    <li><a asp-controller="Sitio" asp-action="Servicios" asp-route-grupo="@grupo.Clave" class="dropdown-item"><i class="fa @grupo.Icono fa-fw me-2 text-danger"></i>@grupo.Nombre</a></li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item"><a asp-controller="Sitio" asp-action="Eventos" class="nav-link @Activo("Eventos", "Evento")">Eventos</a></li>
                        <li class="nav-item"><a asp-controller="Sitio" asp-action="Rutas" class="nav-link @Activo("Rutas")">Rutas</a></li>
                        <li class="nav-item"><a asp-controller="Sitio" asp-action="Contacto" class="nav-link @Activo("Contacto")">Contacto</a></li>

                        @* En pantallas pequeñas la barra superior se oculta: la cuenta se muestra en el menú *@
                        @if (estaConectado)
                        {
                            <li class="nav-item d-lg-none">
                                <form asp-controller="Cuenta" asp-action="Salir" method="post" class="m-0">
                                    <button type="submit" class="nav-link btn btn-link w-100 text-start">Cerrar sesión (@User.Identity!.Name)</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-lg-none"><a asp-controller="Cuenta" asp-action="Registro" class="nav-link">Registrarse</a></li>
                            <li class="nav-item d-lg-none"><a asp-controller="Cuenta" asp-action="Ingresar" class="nav-link">Iniciar sesión</a></li>
                        }
                    </ul>
                    <a asp-controller="Asistente" asp-action="Index" class="jm-btn jm-btn--sm mt-2 mt-lg-0" aria-label="Asistente virtual">
                        <i class="fa fa-robot"></i><span class="d-lg-none d-xl-inline">Asistente virtual</span>
                    </a>
                </div>
            </nav>
        </div>
    </header>

    @if (IsSectionDefined("Portada"))
    {
        @RenderSection("Portada")
    }
    else
    {
        <!-- Encabezado de página: el mapa de Jimaní (CartoArt) como fondo -->
        <section class="jm-cabecera">
            <div class="jm-cabecera__mapa" style="background-image: url('@urlMapa');" aria-hidden="true"></div>
            <div class="jm-patron jm-patron--claro" aria-hidden="true"></div>
            <div class="container">
                <nav class="jm-migas jm-vidrio jm-vidrio--oscuro" aria-label="Ruta de navegación">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Sitio" asp-action="Index">Inicio</a></li>
                        @if (ViewData["MigaTexto"] is string migaTexto && ViewData["MigaUrl"] is string migaUrl)
                        {
                            <li class="breadcrumb-item"><a href="@migaUrl">@migaTexto</a></li>
                        }
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>
                <h1>@ViewData["Title"]</h1>
                @if (ViewData["Subtitulo"] is string subtitulo)
                {
                    <p>@subtitulo</p>
                }
            </div>
            <svg class="jm-dunas" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 50 Q240 10 480 42 T960 38 T1440 30 V90 H0Z" fill="#f7c48f" opacity=".6" />
                <path d="M0 70 Q300 40 620 64 T1200 56 T1440 60 V90 H0Z" fill="var(--arena)" />
            </svg>
        </section>
    }

    <main id="contenido">
        @if (TempData["Exito"] is string exito)
        {
            <div class="container pt-4">
                <div class="jm-alerta d-flex align-items-center justify-content-between gap-3" role="status">
                    <span><i class="fa fa-check-circle text-danger me-2"></i>@exito</span>
                    <button type="button" class="btn-close" aria-label="Cerrar" onclick="this.closest('.container').remove()"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Pie de página -->
    <footer class="jm-footer">
        <div class="jm-franja-taina" aria-hidden="true"></div>
        <div class="jm-patron jm-patron--claro" aria-hidden="true"></div>
        <div class="container position-relative py-5">
            <div class="row g-5 py-3">
                <div class="col-lg-4">
                    <a asp-controller="Sitio" asp-action="Index" class="jm-marca mb-3">
                        <span class="jm-marca__icono"><svg aria-hidden="true"><use href="#t-carita" /></svg></span>
                        <span>Turismo Jimaní<small>Independencia · RD</small></span>
                    </a>
                    <p class="mt-3">Naturaleza, memoria taína y cultura de frontera, entre el Lago Enriquillo y la Sierra de Bahoruco.</p>
                    <button type="button" class="jm-footer__carita" data-dato>
                        <svg aria-hidden="true"><use href="#t-carita" /></svg>
                        <span>Toca la carita: ¿sabías que…?</span>
                    </button>
                </div>
                <div class="col-6 col-lg-2">
                    <h3>Explora</h3>
                    <ul>
                        <li><a asp-controller="Sitio" asp-action="Nosotros">Sobre Jimaní</a></li>
                        <li><a asp-controller="Sitio" asp-action="Lugares">Destinos</a></li>
                        <li><a asp-controller="Sitio" asp-action="Eventos">Eventos y promociones</a></li>
                        <li><a asp-controller="Sitio" asp-action="Rutas">Rutas</a></li>
                        <li><a asp-controller="Sitio" asp-action="Sorpresa">Sorpréndeme</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h3>Planifica</h3>
                    <ul>
                        @foreach (var grupo in SitioPublico.GruposServicio)
                        {
                            <li><a asp-controller="Sitio" asp-action="Servicios" asp-route-grupo="@grupo.Clave">@grupo.Nombre</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h3>Contacto</h3>
                    <ul>
                        @if (!string.IsNullOrWhiteSpace(direccion))
                        {
                            <li><i class="fa fa-map-marker-alt me-2 text-warning"></i>@direccion</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(telefono))
                        {
                            <li><a href="tel:@telefono"><i class="fa fa-phone-alt me-2 text-warning"></i>@telefono</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(correo))
                        {
                            <li><a href="mailto:@correo"><i class="fa fa-envelope me-2 text-warning"></i>@correo</a></li>
                        }
                        <li><a asp-controller="Asistente" asp-action="Index"><i class="fa fa-robot me-2 text-warning"></i>Asistente virtual 24/7</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="jm-creditos position-relative">
            <div class="container py-3 d-flex flex-column flex-lg-row justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year Turismo Jimaní. Todos los derechos reservados.</span>
                <span>
                    Mapa de Jimaní: <a href="https://www.cartoart.net" target="_blank" rel="noopener">CartoArt</a>
                    · Datos &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
                    · <a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a>.
                    Las fotos pertenecen a sus autores.
                </span>
            </div>
        </div>
    </footer>

    <!-- Dato curioso flotante -->
    <div id="jm-toast" class="jm-toast jm-vidrio" role="status" aria-live="polite" hidden>
        <svg aria-hidden="true"><use href="#t-carita" /></svg>
        <div>
            <span class="jm-etiqueta" data-dato-categoria>Dato curioso</span>
            <p data-dato-texto></p>
        </div>
        <button type="button" class="btn-close" aria-label="Cerrar" data-toast-cerrar></button>
    </div>

    <a href="#" class="jm-arriba jm-vidrio" aria-label="Volver arriba"><i class="fa fa-arrow-up"></i></a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/sitio/js/jimani.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
