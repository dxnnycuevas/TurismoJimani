@inject Microsoft.Extensions.Configuration.IConfiguration Configuracion
@{
    // El menú del panel y el cierre por inactividad solo aplican al personal (Administrador o Editor)
    var esPersonal = RolesSistema.EsPersonal(User);
    var minutosInactividad = Configuracion.GetValue("Sesion:MinutosInactividad", 20);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Turismo Jimaní</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppDonnyCuevas20210074.styles.css" asp-append-version="true" />
</head>
<body>
    @if (esPersonal)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">Turismo Jimaní</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Mostrar menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Inicio</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Lugares</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Lugares" asp-action="Index">Lugares</a></li>
                                    <li><a class="dropdown-item" asp-controller="Imagenes" asp-action="Index">Imágenes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Horarios" asp-action="Index">Horarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Contactos" asp-action="Index">Contactos</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Atractivos" asp-action="Index">Atractivos</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Prestadores de servicios</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Prestadores" asp-action="Index">Todos los prestadores</a></li>
                                    <li><a class="dropdown-item" asp-controller="Prestadores" asp-action="Index" asp-route-clase="Persona"><i class="fa fa-user fa-fw me-1"></i>Personas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Prestadores" asp-action="Index" asp-route-clase="Establecimiento"><i class="fa fa-store fa-fw me-1"></i>Establecimientos</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="TiposPrestador" asp-action="Index">Tipos de servicio</a></li>
                                    <li><a class="dropdown-item" asp-controller="Servicios" asp-action="Index">Comodidades</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Rutas" asp-action="Index">Rutas</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Contenido</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Eventos" asp-action="Index">Eventos y promociones</a></li>
                                    <li><a class="dropdown-item" asp-controller="DatosCuriosos" asp-action="Index">Datos curiosos</a></li>
                                </ul>
                            </li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Usuarios</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Roles</a></li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Asistente</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Asistente" asp-action="Index">Chat del asistente</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Intenciones" asp-action="Index">Intenciones</a></li>
                                    <li><a class="dropdown-item" asp-controller="EjemplosIntencion" asp-action="Index">Ejemplos de intención</a></li>
                                    <li><a class="dropdown-item" asp-controller="DocumentosConocimiento" asp-action="Index">Documentos de conocimiento</a></li>
                                    <li><a class="dropdown-item" asp-controller="ConsultasAsistente" asp-action="Index">Consultas</a></li>
                                </ul>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Sitio" asp-action="Index" class="btn btn-outline-primary btn-sm" target="_blank">Ver sitio público</a>
                            <span class="text-muted small">@User.Identity?.Name</span>
                            <form asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Exito"] is string exito)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @exito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Turismo Jimaní
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (esPersonal)
    {
        @* Cierra la pantalla cuando la sesión del servidor ya caducó por inactividad *@
        <script id="sesion-inactividad" src="~/js/sesion.js" asp-append-version="true"
                data-minutos="@minutosInactividad"
                data-url-expirada="@Url.Action("Login", "Cuenta", new { expirada = true })"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
