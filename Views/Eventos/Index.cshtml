@model IEnumerable<Evento>
@{
    ViewData["Title"] = "Eventos y promociones";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">Eventos y promociones</h2>
    <a asp-action="Create" class="btn btn-primary">Nuevo evento</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por título, tipo o lugar" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay registros para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Tipo</th>
                    <th>Inicio</th>
                    <th>Lugar</th>
                    <th>Publicado</th>
                    <th>Destacado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Titulo</td>
                        <td>@item.Tipo</td>
                        <td>@Formato.Fecha(item.FechaInicio)</td>
                        <td>@(item.Lugar?.Nombre ?? item.LugarTexto)</td>
                        <td>@Formato.SiNo(item.Publicado)</td>
                        <td>@Formato.SiNo(item.Destacado)</td>
                        <td class="text-end text-nowrap">
                            @if (item.Publicado)
                            {
                                <a asp-controller="Sitio" asp-action="Evento" asp-route-id="@item.IdEvento" class="btn btn-sm btn-outline-success" target="_blank">En el sitio</a>
                            }
                            <a asp-action="Details" asp-route-id="@item.IdEvento" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.IdEvento" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdEvento" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Total: @Model.Count() registro(s)</p>
}
