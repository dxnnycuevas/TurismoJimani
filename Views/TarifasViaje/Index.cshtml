@model IEnumerable<TarifaViaje>
@{
    ViewData["Title"] = "Tarifas de viaje";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h2 class="mb-0">Tarifas de viaje</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva tarifa</a>
</div>
<p class="text-muted">Pasajes hasta Jimaní. El asistente los usa cuando alguien pregunta, por ejemplo, «tengo 10,000 pesos para 5 días».</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay tarifas registradas. Sin ellas, el presupuesto del asistente no incluye el pasaje.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Ciudad de salida</th>
                    <th>Medio</th>
                    <th>Ida</th>
                    <th>Ida y vuelta</th>
                    <th>Horas</th>
                    <th>Activa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Origen</td>
                        <td>@item.Medio</td>
                        <td>@SitioPublico.Precio(item.PrecioIda)</td>
                        <td>@SitioPublico.Precio(item.PrecioIda * 2)</td>
                        <td>@Formato.Numero(item.HorasViaje)</td>
                        <td>@Formato.SiNo(item.Activo)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.IdTarifa" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdTarifa" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
