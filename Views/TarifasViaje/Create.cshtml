@model TarifaViaje
@{
    ViewData["Title"] = "Nueva tarifa de viaje";
}

<h2>Nueva tarifa de viaje</h2>
<p class="text-muted">Precio del pasaje desde una ciudad hasta Jimaní. El asistente lo usa para armar presupuestos de viaje.</p>
<hr />

<form asp-action="Create" method="post">
    <partial name="_Formulario" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
